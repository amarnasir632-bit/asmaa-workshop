# Environment template for the InfinityFree trial deployment.
# Copy this file to htdocs/asmaa/.env (NOT to htdocs) and fill the placeholders.
# Never commit the filled file to Git.

APP_NAME="مشغل أسماء"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://REPLACE-WITH-YOUR-SUBDOMAIN.42web.io
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Africa/Khartoum

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database credentials from the InfinityFree control panel (MySQL Databases page).
DB_CONNECTION=mysql
DB_HOST=REPLACE-WITH-sqlXXX.infinityfree.com
DB_PORT=3306
DB_DATABASE=REPLACE-WITH-if0_XXXXXXXX_asmaa
DB_USERNAME=REPLACE-WITH-if0_XXXXXXXX
DB_PASSWORD=REPLACE-WITH-DATABASE-PASSWORD

# Database sessions avoid the shared-host file-session constraints.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=private
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log

# Manual backups only on the InfinityFree free plan (no cron). Keep the key offline.
# Generate with: php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
APP_BACKUP_KEY=
BACKUP_DISK=backups

VITE_APP_NAME="${APP_NAME}"
