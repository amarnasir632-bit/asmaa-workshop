{
  "name": "asmaa-workshop-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply asmaa-workshop --local",
    "db:migrate:remote": "wrangler d1 migrations apply asmaa-workshop --remote",
    "test": "node --test test/*.test.js && vitest run --config vitest.config.js"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.0.0"
  }
}
