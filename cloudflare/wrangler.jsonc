{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "asmaa-workshop",
  "main": "src/index.js",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "asmaa-workshop",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PAYMENT_EVIDENCE",
      "bucket_name": "asmaa-workshop-private"
    }
  ]
}
